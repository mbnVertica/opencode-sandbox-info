    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@opentui/core": "0.5.13",
    "@opentui/solid": "0.5.13",
    "@types/node": "24.10.1",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
